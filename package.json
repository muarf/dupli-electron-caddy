{
  "name": "dupli-electron-alpha",
  "version": "2.0.1-alpha.local",
  "main": "main-caddy.js",
  "scripts": {
    "start": "electron . --no-sandbox --disable-gpu",
    "start:php": "electron main.js --no-sandbox --disable-gpu",
    "start:caddy": "electron main-caddy.js --no-sandbox --disable-gpu",
    "dev": "cross-env NODE_ENV=development electron . --no-sandbox --disable-gpu",
    "build": "electron-builder",
    "build:caddy": "electron-builder --config electron-builder-caddy.yml",
    "download-caddy": "node scripts/download-caddy.js",
    "download-binaries": "node scripts/download-binaries.js",
    "download-php": "node -e \"require('./scripts/download-caddy.js').downloadPhp()\"",
    "download-all": "npm run download-caddy && npm run download-binaries && npm run download-php",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:integration:simple": "jest --testPathPattern=caddy-php-simple",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "rebuild:print-engine": "cd src/print-engine/windows && node-gyp rebuild"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Duplicator - Application de duplication de documents",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/jest": "^29.5.14",
    "cross-env": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "node-gyp": "^10.0.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "main*.js",
      "scripts/**/*.js",
      "!node_modules/**",
      "!dist/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "build": {
    "appId": "com.dupli.alpha",
    "productName": "Duplicator Alpha",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main-caddy.js",
      "main.js",
      "preload.js",
      "Caddyfile",
      "app/**/*",
      "php/**/*",
      "bin/**/*",
      "caddy/**/*",
      "src/**/*",
      "utils/**/*",
      "!app/vendor/phpunit/**/*",
      "!app/vendor/pestphp/**/*",
      "!app/vendor/sebastian/**/*",
      "!app/vendor/**/tests/**/*",
      "!app/vendor/**/test/**/*",
      "!app/vendor/**/docs/**/*"
    ],
    "asarUnpack": [
      "php/**/*",
      "app/**/*",
      "bin/**/*",
      "caddy/**/*",
      "src/**/*",
      "utils/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "executableName": "Duplicator",
      "executableArgs": [
        "--no-sandbox",
        "--disable-gpu",
        "--disable-setuid-sandbox"
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "forceCodeSigning": false,
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Duplicator",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Duplicator-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "electron-updater": "^6.6.2",
    "node-addon-api": "^7.0.0",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.17.2",
    "sharp": "^0.33.3",
    "sqlite3": "^5.1.7"
  },
  "productName": "Duplicator Alpha"
}
