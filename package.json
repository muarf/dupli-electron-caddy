{
  "name": "dupli-tauri-alpha",
  "version": "3.0.0-alpha.local",
  "scripts": {
    "download-caddy": "node scripts/download-caddy.js",
    "download-binaries": "node scripts/download-binaries.js",
    "download-php": "node -e \"require('./scripts/download-caddy.js').downloadPhp()\"",
    "download-all": "npm run download-caddy && npm run download-binaries && npm run download-php",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:integration:simple": "jest --testPathPattern=caddy-php-simple",
    "test:e2e": "xvfb-run -a playwright test",
    "test:e2e:smoke": "xvfb-run -a playwright test tests/e2e/smoke.test.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start-php": "php\\php.exe -S 127.0.0.1:8000 -t app\\public",
    "tauri": "tauri",
    "dev": "npx @tauri-apps/cli dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Duplicator - Application de duplication de documents",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "node-gyp": "^10.0.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "collectCoverageFrom": [
      "scripts/**/*.js",
      "!node_modules/**",
      "!dist/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "dependencies": {
    "node-addon-api": "^7.0.0",
    "pdfkit": "^0.17.2",
    "sharp": "^0.33.3"
  },
  "productName": "Duplicator Alpha"
}
